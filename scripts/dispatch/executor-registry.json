{
  "schema": "ai-agents.executor-registry.v1",
  "tags": {
    "hard": ["write", "build-test", "web", "browse", "desktop-control", "image-gen"],
    "constraint": ["family", "gated"]
  },
  "flags": ["E", "T"],
  "codexEfforts": ["none", "minimal", "low", "medium", "high", "xhigh", "max"],
  "retiredProfiles": ["default", "implement", "intensive", "deep", "deep-review", "scan", "content"],
  "maxIncomplete": 3,
  "types": {
    "edit": { "requiredFlags": ["E", "T"], "impliedTags": ["write"], "forbiddenTags": [] },
    "survey": { "requiredFlags": [], "impliedTags": [], "forbiddenTags": ["write"] },
    "test": { "requiredFlags": [], "impliedTags": [], "forbiddenTags": ["write"] },
    "generate": { "requiredFlags": [], "impliedTags": ["image-gen"], "forbiddenTags": ["write"] },
    "factcheck": { "requiredFlags": [], "impliedTags": ["web"], "forbiddenTags": ["write"] },
    "review": { "requiredFlags": [], "impliedTags": [], "forbiddenTags": ["write"], "preferred": ["family"] },
    "advise": { "requiredFlags": [], "impliedTags": [], "forbiddenTags": ["write"], "skippable": true }
  },
  "executors": [
    {
      "id": "haiku", "display": "Haiku subagent", "platform": "claude", "model": "haiku", "family": "claude",
      "accepts": ["edit"], "tags": ["write", "build-test"], "when": { "E": true, "T": false },
      "order": 10, "gated": false
    },
    {
      "id": "codex-test", "display": "Codex test", "platform": "codex", "profile": "test", "family": "codex", "entry": "scripts/Invoke-CodexRun.ps1",
      "profileSettings": {
        "model": "gpt-6.1-terra", "effort": "max", "subagentModel": "gpt-6-luna", "subagentEffort": "max",
        "mcpServers": {
          "playwright": {
            "command": "npx", "args": ["-y", "@playwright/mcp@latest"], "envVars": ["PLAYWRIGHT_MCP_OUTPUT_DIR"],
            "enabledTools": ["browser_navigate", "browser_navigate_back", "browser_snapshot", "browser_click", "browser_hover", "browser_type", "browser_fill_form", "browser_press_key", "browser_select_option", "browser_wait_for", "browser_take_screenshot", "browser_console_messages", "browser_network_requests", "browser_tabs", "browser_close"]
          },
          "flaui-mcp": {
            "enabledTools": ["windows_attach", "windows_inspect", "windows_snapshot", "windows_click", "windows_get_text", "windows_screenshot"]
          }
        }
      },
      "accepts": ["test"], "tags": ["web", "browse", "desktop-control"], "when": {},
      "order": 20, "gated": false
    },
    {
      "id": "codex-review", "display": "Codex review", "platform": "codex", "profile": "review", "family": "codex", "entry": "scripts/Invoke-CodexRun.ps1",
      "profileSettings": { "model": "gpt-6.2-sol", "effort": "medium", "subagentModel": "gpt-6-luna", "subagentEffort": "max", "fallbackModels": ["gpt-5.6-terra"] },
      "accepts": ["review"], "tags": [], "when": {},
      "order": 30, "gated": false
    },
    {
      "id": "codex-factcheck", "display": "Codex factcheck", "platform": "codex", "profile": "factcheck", "family": "codex", "entry": "scripts/Invoke-CodexRun.ps1",
      "profileSettings": { "model": "gpt-6.2-sol", "effort": "medium", "subagentModel": "gpt-6-luna", "subagentEffort": "max" },
      "accepts": ["generate", "factcheck"], "tags": ["web", "image-gen"], "when": {},
      "order": 35, "gated": false
    },
    {
      "id": "codex-advisor", "display": "Codex advisor", "platform": "codex", "profile": "advisor", "family": "codex", "entry": "scripts/Invoke-CodexRun.ps1",
      "profileSettings": { "model": "gpt-6.2-sol", "effort": "high", "subagentModel": "gpt-6-luna", "subagentEffort": "max" },
      "accepts": ["advise"], "tags": [], "when": {},
      "order": 40, "gated": true
    },
    {
      "id": "sonnet", "display": "Sonnet subagent", "platform": "claude", "model": "sonnet", "family": "claude",
      "accepts": ["edit", "survey", "review", "factcheck", "test"], "tags": ["write", "build-test", "web"], "when": {},
      "order": 50, "gated": false
    },
    {
      "id": "opus", "display": "Opus subagent", "platform": "claude", "model": "opus", "family": "claude",
      "accepts": ["edit", "survey", "review", "factcheck"], "tags": ["write", "build-test", "web"], "when": {},
      "order": 90, "gated": false
    }
  ]
}
